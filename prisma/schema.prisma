generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(cuid())

  username         String?         @unique
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?

  githubId         String?         @unique
  githubAuthorized Boolean         @default(false)
  githubAccessToken String?

  accounts         Account[]
  sessions         Session[]

  projectMemberships ProjectMember[]
  createdIssues    Issue[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("users")
}


model Account {
  id                String   @id @default(cuid())

  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type              String
  provider          String
  providerAccountId String

  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])

  @@map("accounts")
}


model Session {
  id           String   @id @default(cuid())

  sessionToken String   @unique

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires      DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])

  @@map("sessions")
}

model Project {
  id           String             @id @default(cuid())

  name         String
  slug         String             @unique
  description  String?

  status       ProjectStatus      @default(ACTIVE)

  members      ProjectMember[]
  repositories GitHubRepository[]
  boards       Board[]
  issues       Issue[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())

  userId    String
  projectId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role      Role     @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
  @@index([userId])

  @@map("project_members")
}

model GitHubRepository {
  id            String   @id @default(cuid())

  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // GitHub's repository ID
  githubId      BigInt

  owner         String
  name          String
  fullName      String

  description   String?  @db.Text
  url           String

  defaultBranch String   @default("main")

  isPrivate     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, githubId])
  @@index([projectId])

  @@map("github_repositories")
}

model Board {
  id        String   @id @default(cuid())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String

  sections  BoardSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])

  @@map("boards")
}

model BoardSection {
  id        String   @id @default(cuid())

  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  name      String
  position  Int

  issues    Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([boardId, position])

  @@map("board_sections")
}

model Issue {
  id          String   @id @default(cuid())

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sectionId   String
  section     BoardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text

  position    Int

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([sectionId])
  @@index([sectionId, position])

  @@map("issues")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}